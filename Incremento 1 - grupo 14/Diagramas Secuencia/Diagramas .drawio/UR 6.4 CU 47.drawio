  <diagram name="Página-1" id="LVOWJGvxHgO-abdjPrT2">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="FgY2k2iMYHfPgYxb8Yzi-1" parent="1" style="text;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;div data-ccp-timestamp=&quot;1781102642843&quot;&gt;&lt;table width=&quot;566&quot; style=&quot;border-collapse:collapse;width:425pt&quot;&gt;&lt;colgroup&gt;&lt;col width=&quot;115&quot; style=&quot;width:86pt&quot;&gt;&lt;col width=&quot;451&quot; style=&quot;width:338pt&quot;&gt;&lt;/colgroup&gt;&lt;tbody&gt;&lt;tr height=&quot;21&quot; style=&quot;height:15.75pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;21&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:15.75pt&quot;&gt;Nombre&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;CU-47: Ajustando umbrales de alerta&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;21&quot; style=&quot;height:15.75pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;21&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:15.75pt&quot;&gt;Actor(es)&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;Gerencia&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;50&quot; style=&quot;height:37.5pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;50&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:37.5pt&quot;&gt;Resumen&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;Permite configurar valores mínimos, máximos&lt;span style=&quot;mso-spacerun:yes&quot;&gt;&amp;nbsp; &lt;/span&gt;y críticos por producto para adaptar el sistema a la demanda.&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;21&quot; style=&quot;height:15.75pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;21&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:15.75pt&quot;&gt;Frecuencia&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;Media&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;21&quot; style=&quot;height:15.75pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;21&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:15.75pt&quot;&gt;Precondiciones&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;Producto registrado.&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;118&quot; style=&quot;height:88.5pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;118&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:88.5pt&quot;&gt;Descripción&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;El sistema habilita la edición de umbrales. El usuario ingresa los nuevos valores de stock mínimo, stock máximo y stock crítico [Excepción 1]. El sistema valida que los valores ingresados sean válidos y que el stock crítico sea menor o igual al stock mínimo [Excepción 2]. Una vez validad la información, el sistema guarda la configuración.&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;61&quot; style=&quot;height:45.75pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;61&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:45.75pt&quot;&gt;Excepciones&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;Excepción 1: Se ingresan valores no númericos o negativos.&lt;span style=&quot;mso-spacerun:yes&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;/span&gt;Excepción 2: El valor de stock crítico es mayor que el stock mínimo o el valor de stock máximo es menor que el stock mínimo.&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;18&quot; style=&quot;height:13.5pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;18&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:13.5pt&quot;&gt;Poscondiciones&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;Se actualiza la sensibilidad del motor de alertas del producto.&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;21&quot; style=&quot;height:15.75pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;21&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:15.75pt&quot;&gt;Dependencias&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;UR 6.4&lt;/td&gt;&lt;/tr&gt;&lt;tr height=&quot;21&quot; style=&quot;height:15.75pt&quot;&gt;&lt;td width=&quot;115&quot; height=&quot;21&quot; class=&quot;xl19&quot; style=&quot;width:86pt;height:15.75pt&quot;&gt;Campo&lt;/td&gt;&lt;td width=&quot;451&quot; class=&quot;xl19&quot; style=&quot;width:338pt&quot;&gt;Descripción&lt;/td&gt;&lt;/tr&gt;&lt;/tbody&gt;&lt;/table&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="420" width="560" x="340" y="120" as="geometry" />
