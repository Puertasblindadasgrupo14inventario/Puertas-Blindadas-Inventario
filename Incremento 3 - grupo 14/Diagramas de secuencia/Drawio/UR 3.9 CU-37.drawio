        <mxCell id="ZZx4ATUXN3obNgGbkRAW-56" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="1. Accede al módulo de conteo cíclico y selecciona la bodega a revisar" vertex="1">
          <mxGeometry height="40" width="220" x="-830" y="470" as="geometry" />
        </mxCell>
        <mxCell id="ZZx4ATUXN3obNgGbkRAW-57" parent="1" style="text;whiteSpace=wrap;html=1;" value="6. Obtener el nombre y la unidad de medida de cada material" vertex="1">
