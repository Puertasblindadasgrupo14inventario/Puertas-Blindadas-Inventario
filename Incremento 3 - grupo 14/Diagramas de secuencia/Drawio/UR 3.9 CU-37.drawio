        </mxCell>
        <mxCell id="ZZx4ATUXN3obNgGbkRAW-58" parent="1" style="text;whiteSpace=wrap;html=1;" value="8. Entregar los materiales de la bodega" vertex="1">
          <mxGeometry height="30" width="230" x="-280" y="780" as="geometry" />
        </mxCell>
        <mxCell id="ZZx4ATUXN3obNgGbkRAW-59" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="9. Verificar que la bodega tenga productos asignados" vertex="1">
          <mxGeometry height="40" width="200" x="-260" y="840" as="geometry" />
        </mxCell>
        <mxCell id="ZZx4ATUXN3obNgGbkRAW-60" parent="1" style="text;whiteSpace=wrap;html=1;align=center;" value="10. Consultar si existe un conteo previo para la bodega en la fecha actual" vertex="1">
